# ------------------------------------------------------------------
# Slate — environment configuration template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# Application
APP_NAME=Slate
APP_ENV=local
APP_URL=http://localhost:8000
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=slate
DB_USERNAME=root
DB_PASSWORD=

# Mail (PHPMailer / SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@slate.test
MAIL_FROM_NAME="Slate Bookings"

# Homepage footer credit (shown on the public / page).
SITE_AUTHOR="your name"
SITE_GITHUB_URL=https://github.com/yourhandle/slate

# Demo mode — set to true on the public deployment so recruiters can poke
# safely. Shows credentials banner on /, blocks destructive admin actions,
# and enables the /cron/reset-demo endpoint (gated by DEMO_RESET_TOKEN).
DEMO_MODE=false
DEMO_RESET_TOKEN=change-me-to-a-long-random-string
