{
    "name": "slate/booking-system",
    "description": "Slate — vanilla PHP 8.2 appointment booking system (no framework).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6",
        "nesbot/carbon": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\Core\\":               "app/core/",
            "App\\Controllers\\":        "app/controllers/",
            "App\\Controllers\\Admin\\": "app/controllers/admin/",
            "App\\Controllers\\Api\\":   "app/controllers/api/",
            "App\\Controllers\\Api\\Admin\\": "app/controllers/api/admin/",
            "App\\Middleware\\":         "app/middleware/",
            "App\\Models\\":             "app/models/",
            "App\\Services\\":           "app/services/"
        },
        "files": [
            "app/helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test":         "phpunit",
        "test:unit":    "phpunit --testsuite=Unit",
        "test:feature": "phpunit --testsuite=Feature"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
